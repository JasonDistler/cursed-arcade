* text=auto eol=lf

# Windows scripts must keep CRLF line endings or some CMD versions misparse
# labels, pause, and goto. Force CRLF on checkout no matter the host OS.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# macOS / Linux shells must stay LF
*.command text eol=lf
*.sh      text eol=lf

# Binary assets — never normalize
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
